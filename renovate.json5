{
  // validate with (see: https://docs.renovatebot.com/config-validation/):
  // npx --yes --package renovate -- renovate-config-validator renovate.json5 --strict

  customManagers: [
    {
      customType: 'regex',
      description: 'Update centralized CI and tooling versions',
      managerFilePatterns: ['/^versions\\.yaml$/'],
      matchStrings: [
        '# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)(?: versioning=(?<versioning>\\S+))?\\n\\s+[A-Z][A-Z0-9_]*: "(?<currentValue>[^"\\n]+)"',
      ],
      versioningTemplate: '{{#if versioning}}{{{versioning}}}{{else}}semver{{/if}}',
    },
  ],
  dependencyDashboard: {
    labels: ['effort | ongoing', 'scope | dependencies'],
    osvVulnerabilitySummary: 'all',
  },
  extends: [
    // Recommended defaults
    'config:recommended',
    // Pin GitHub Actions to commit SHAs
    'helpers:pinGitHubActionDigests',
    // Exact action versions (# v6.1.1) so minimumReleaseAge can pass
    'helpers:pinGitHubActionDigestsToSemver',
    // Automerge digest updates
    'default:automergeDigest',
    // Automerge minor and patch updates
    'default:automergeMinor',
    // One PR for patch and minor updates
    'default:combinePatchMinorReleases',
    // Dependency dashboard issue
    'default:dependencyDashboard',
    // PRs for GitHub vulnerability alerts
    'default:enableVulnerabilityAlerts',
    // Refresh lockfiles weekly
    'default:maintainLockFilesWeekly',
    // At most 4 PRs per hour
    'default:prHourlyLimit4',
  ],
  // Wait 14 days before creating PRs (supply chain attacks).
  // see: https://docs.renovatebot.com/configuration-options/#minimumreleaseage
  minimumReleaseAge: '14 days',
  // Exclude releases until the age requirement passes, then create PRs
  // immediately rather than waiting for branch checks.
  internalChecksFilter: 'strict',
  prCreation: 'immediate',
  // Also create security PRs from osv.dev data (covers Go modules), independent
  // of whether GitHub Dependabot alerts are readable by the Renovate app.
  // Vulnerability fixes skip minimumReleaseAge and the schedule. Does not cover
  // the Go toolchain or Docker images in versions.yaml.
  // see: https://docs.renovatebot.com/configuration-options/#osvvulnerabilityalerts
  osvVulnerabilityAlerts: true,
  // Commit security updates as fix (otherwise chore), so release-please
  // lists them in the changelog. Applies to OSV and GitHub alert PRs and
  // merges with default:enableVulnerabilityAlerts above.
  // see: https://docs.renovatebot.com/configuration-options/#vulnerabilityalerts
  vulnerabilityAlerts: {
    semanticCommitType: 'fix',
  },
  prConcurrentLimit: 20,
  rebaseWhen: 'conflicted',
  stopUpdatingLabel: 'renovate | stop update',
  packageRules: [
    {
      matchManagers: ['gomod'],
      postUpdateOptions: ['gomodTidy'],
    },
    {
      // Integration tests use the parent checkout via replace; keep its placeholder.
      // Scope this exception narrowly so real driver dependencies still update.
      enabled: false,
      matchFileNames: ['integration/go.mod'],
      matchManagers: ['gomod'],
      matchPackageNames: ['github.com/fuf-stack/hardcore'],
    },
  ],
}
